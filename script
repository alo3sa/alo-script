local CONFIG_FILE = "AloV2Script_config.json"
local configReady = false
local function canFS()
    return typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
end
local function colorToT(c)
    if typeof(c) ~= "Color3" then return nil end
    return { R = c.R, G = c.G, B = c.B }
end
local function tToColor(t)
    if type(t) ~= "table" or t.R == nil then return nil end
    if t.R > 1 or t.G > 1 or t.B > 1 then
        return Color3.fromRGB(t.R, t.G, t.B)
    end
    return Color3.new(t.R, t.G, t.B)
end

local function saveConfig()
    if not canFS() or not configReady then return end
    local ok, err = pcall(function()
        local pack = { version = 2, S = {}, island = nil, uiColor = nil }
        for k, v in pairs(S) do
            local ty = type(v)
            if ty == "boolean" or ty == "number" or ty == "string" then
                pack.S[k] = v
            end
        end
        -- keybind aim
        if S.AimKey and type(S.AimKey) == "table" then
            pack.S.AimKeyKind = S.AimKey.kind
            if S.AimKey.kind == "mouse" then
                pack.S.AimKeyName = tostring(S.AimKey.v):gsub("Enum.UserInputType.", "")
            else
                pack.S.AimKeyName = tostring(S.AimKey.v):gsub("Enum.KeyCode.", "")
            end
        end
        if S.NoclipKey then pack.S.NoclipKeyName = S.NoclipKey.Name end
        if S.TPKey then pack.S.TPKeyName = S.TPKey.Name end
        -- island / ui (via W refs)
        local ic = W and W.island and W.island.cfg
        if ic then
            pack.island = {
                scale = ic.scale,
                stroke = ic.stroke,
                title = ic.title,
                color = colorToT(ic.color),
                color2 = colorToT(ic.color2),
            }
        end
        if W and W.uiColor then pack.uiColor = colorToT(W.uiColor) end
        writefile(CONFIG_FILE, HttpService:JSONEncode(pack))
    end)
end

local function loadConfig()
    if not canFS() or not isfile(CONFIG_FILE) then return end
    pcall(function()
        local pack = HttpService:JSONDecode(readfile(CONFIG_FILE))
        if type(pack) ~= "table" then return end
        if type(pack.S) == "table" then
            for k, v in pairs(pack.S) do
                if k == "AimKeyKind" or k == "AimKeyName" or k == "NoclipKeyName" or k == "TPKeyName" then
                    -- handled below
                elseif S[k] ~= nil and type(S[k]) == type(v) then
                    S[k] = v
                end
            end
            if pack.S.AimKeyKind and pack.S.AimKeyName then
                if pack.S.AimKeyKind == "mouse" then
                    local okm, ev = pcall(function() return Enum.UserInputType[pack.S.AimKeyName] end)
                    if okm and ev then S.AimKey = { kind = "mouse", v = ev } end
                else
                    local okk, ev = pcall(function() return Enum.KeyCode[pack.S.AimKeyName] end)
                    if okk and ev then S.AimKey = { kind = "key", v = ev } end
                end
            end
            if type(pack.S.NoclipKeyName) == "string" then
                local okk, ev = pcall(function() return Enum.KeyCode[pack.S.NoclipKeyName] end)
                if okk and ev then S.NoclipKey = ev end
            end
            if type(pack.S.TPKeyName) == "string" then
                local okk, ev = pcall(function() return Enum.KeyCode[pack.S.TPKeyName] end)
                if okk and ev then S.TPKey = ev end
            end
        end
        -- island restored later when islandCfg exists
        getgenv = getgenv or function() return _G end
        local env = getgenv and getgenv() or _G
        env.__ALO_V2_PENDING_ISLAND = pack.island
        env.__ALO_V2_PENDING_UI = pack.uiColor
    end)
end

