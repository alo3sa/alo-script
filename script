UITab:Section({Title="DYNAMIC ISLAND (WindUI)"})

local function parseColor(c)
    if typeof(c) == "Color3" then return c end
    if type(c) == "table" then
        local r, g, b = c.R or c.r, c.G or c.g, c.B or c.b
        if r == nil then return nil end
        if r > 1 or g > 1 or b > 1 then
            return Color3.fromRGB(r, g, b)
        end
        return Color3.new(r, g, b)
    end
    if type(c) == "string" then
        local hex = c:gsub("#", "")
        if #hex == 6 then
            local n = tonumber(hex, 16)
            if n then
                return Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
            end
        end
    end
    return nil
end

local function setIslandColor(col, silent)
    col = parseColor(col)
    if not col then return end
    islandCfg.color = col
    islandCfg.color2 = Color3.new(
        math.clamp(col.R * 1.25 + 0.08, 0, 1),
        math.clamp(col.G * 1.25 + 0.08, 0, 1),
        math.clamp(col.B * 1.25 + 0.08, 0, 1)
    )
    applyOpenButton()
    if not silent then
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({
                    Title = "Island color",
                    Content = string.format("#%02X%02X%02X", math.floor(col.R * 255), math.floor(col.G * 255), math.floor(col.B * 255)),
                    Duration = 2,
                })
            end
        end)
    end
    scheduleSave()
end

