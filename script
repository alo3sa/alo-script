if o:IsA("GuiObject") then o.BackgroundColor3 = swap(o.BackgroundColor3) end
if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then o.TextColor3 = swap(o.TextColor3) end
if o:IsA("TextBox") then o.PlaceholderColor3 = swap(o.PlaceholderColor3) end
