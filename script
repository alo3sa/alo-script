local function validTarget(m)
    local plr = Players:GetPlayerFromCharacter(m)
    local hasPicks = next(S.FarmPlayers) ~= nil or next(S.FarmNPCNames) ~= nil
    if plr then
        if plr == LP or not wantPlayers() then return false end
        if hasPicks and not S.FarmPlayers[plr] then return false end
        return true
    end
    if not wantNPCs() or not isEnemy(m) then return false end
    if hasPicks and not S.FarmNPCNames[m.Name] then return false end
    return true
end
local function nearestTarget()
    local root = getRoot(); if not root then return nil end
    local best, bd
    local function consider(m)
        if m and m.Parent and isAlive(m) and validTarget(m) then
            local r = m:FindFirstChild("HumanoidRootPart")
            if r then local d=(r.Position-root.Position).Magnitude; if not bd or d<bd then best,bd=m,d end end
        end
    end
    if wantPlayers() then for _,p in ipairs(Players:GetPlayers()) do if p~=LP then consider(p.Character) end end end
    if wantNPCs() then for _,m in ipairs(npcCache) do consider(m) end end
    return best
end

W.upright = function()
    local r = getRoot(); if not r then return end
    local l = r.CFrame.LookVector
    local flat = Vector3.new(l.X,0,l.Z)
    if flat.Magnitude < 0.01 then flat = Vector3.new(0,0,-1) end
    r.CFrame = CFrame.lookAt(r.Position, r.Position+flat.Unit)
    r.AssemblyAngularVelocity = Vector3.zero
end

