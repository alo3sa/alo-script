        end
    elseif curHitboxOn() then setHitbox(t,true) end
    local base = (not isPlayer and bringOn and farm.pile) or tr.Position
    local desired = base + Vector3.new(0, hoverHeight(), 0)
    if (root.Position-desired).Magnitude > 60 then return end
    root.CFrame = CFrame.new(desired) * CFrame.Angles(-math.pi/2,0,0)
end))

local function killTarget(target)
    if os.clock()-farm.lastSim > 5 then farm.lastSim=os.clock(); boostOwnership() end
    local isPlayer = Players:GetPlayerFromCharacter(target) ~= nil
    setStatus("Killing "..(isPlayer and target.Name.." (player)" or target.Name))
    local tr = target:FindFirstChild("HumanoidRootPart")
    if tr then travelTo(tr.Position+Vector3.new(0,hoverHeight(),0), S.FarmSpeed) end
    tr = target:FindFirstChild("HumanoidRootPart")
    local r3 = getRoot()
    if not tr or not r3 or (r3.Position-tr.Position).Magnitude > hoverHeight()+80 then return end
    farm.pile = (not isPlayer and tr) and tr.Position or nil
    farm.target = target
    local t0 = os.clock()
    local tHum = target:FindFirstChildOfClass("Humanoid")
    local hp0,hpCheck = tHum and tHum.Health or 0, os.clock()
    local lastEquip = 0
    while alive and farmOn() and target.Parent and isAlive(target) and os.clock()-t0 < 25 do
        local h = getHum(); if not h or h.Health <= 0 then break end
        if os.clock() < farm.pauseUntil then task.wait(0.1); hpCheck = os.clock()
        else
            if os.clock()-lastEquip > 1 then lastEquip=os.clock(); autoEquip() end
            local r4,t4 = getRoot(), target:FindFirstChild("HumanoidRootPart")
            if r4 and t4 and (r4.Position-t4.Position).Magnitude > hoverHeight()+60 then
                travelTo(t4.Position+Vector3.new(0,hoverHeight(),0), S.FarmSpeed)
            end
            attack(target); task.wait(0.1)
            if tHum and os.clock()-hpCheck > 3 then
                if tHum.Health >= hp0 then
                    if S.AttackMode == "Auto" then
                        farm.methodIdx = farm.methodIdx % #ATTACK_METHODS + 1
                        setStatus("No damage - trying: "..ATTACK_METHODS[farm.methodIdx])
                    else setStatus("Hits not registering - change Attack mode") end
                end
                hp0,hpCheck = tHum.Health, os.clock()
            end
        end
    end
    farm.target = nil; farm.pile = nil
end

