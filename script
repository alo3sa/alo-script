UITab:Section({Title="WINDOW UI COLOR"})

local uiColor = Color3.fromRGB(16, 16, 18)
W.uiColor = uiColor

local function applyWindowColor(col)
    col = parseColor(col)
    if not col then return end
    uiColor = col
    W.uiColor = col
    local function shade(c, f)
        return Color3.new(
            math.clamp(c.R * f, 0, 1),
            math.clamp(c.G * f, 0, 1),
            math.clamp(c.B * f, 0, 1)
        )
    end
    local function mix(a, b, t)
        return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
    end
    local white = Color3.new(1, 1, 1)
    local accent = mix(col, white, 0.08)
    local theme = {
        Name = "ALOCustom",
        Accent = accent,
        Dialog = shade(col, 0.92),
        Outline = Color3.fromRGB(255, 255, 255),
        Text = Color3.fromRGB(255, 255, 255),
        Placeholder = Color3.fromRGB(161, 161, 170),
        Background = shade(col, 0.7),
        Button = Color3.fromRGB(82, 82, 91),
        Icon = Color3.fromRGB(161, 161, 170),
        Toggle = Color3.fromRGB(51, 199, 89),
        Slider = Color3.fromRGB(0, 145, 255),
        Checkbox = Color3.fromRGB(0, 145, 255),
        Primary = Color3.fromRGB(0, 145, 255),
        SliderIcon = Color3.fromRGB(144, 143, 149),
        PanelBackground = Color3.fromRGB(255, 255, 255),
        PanelBackgroundTransparency = 0.95,
        LabelBackground = Color3.fromRGB(0, 0, 0),
        LabelBackgroundTransparency = 0.83,
        ElementBackground = Color3.fromRGB(42, 42, 44),
        ElementBackgroundTransparency = 0,
    }
    pcall(function()
        WindUI:AddTheme(theme)
        WindUI:SetTheme("ALOCustom")
    end)
    scheduleSave()
    pcall(function()
        if WindUI and WindUI.Notify then
            WindUI:Notify({
                Title = "UI color",
                Content = string.format("#%02X%02X%02X", math.floor(col.R * 255), math.floor(col.G * 255), math.floor(col.B * 255)),
                Duration = 2,
            })
        end
    end)
    if W.syncIslandToUI then
        setIslandColor(col, true)
    end
end

