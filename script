local function hitPartOf(m)
    return m:FindFirstChild("RightLowerLeg") or m:FindFirstChild("LeftLowerLeg")
        or m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart")
end
local ATTACK_METHODS = {"Remote (session)","Remote (old format)","Tool swing only"}
local function remoteHit(mobs, useSession)
    local ra, rh = netRemote("RE/RegisterAttack"), netRemote("RE/RegisterHit")
    if not ra or not rh then return false end
    local primary, others = nil, {}
    for _, m in ipairs(mobs) do
        local p = hitPartOf(m)
        if p then if not primary then primary=p else others[#others+1]={m,p} end end
    end
    if not primary then return false end
    local session = useSession and combatSession() or nil
    farm.sessionMissing = useSession and (session==nil) or false
    pcall(function() ra:FireServer(0.5) end); task.wait()
    if useSession then pcall(function() rh:FireServer(primary, others, nil, session) end)
    else pcall(function() rh:FireServer(primary, others) end) end
    return true
end
W.hit = function(list) remoteHit(list, combatSession() ~= nil) end

local function curHitboxOn() return S.RaidOn and S.RaidHitbox or (not S.RaidOn and S.Hitbox) end
local function curHitReach() return S.RaidOn and S.RaidHitReach or S.HitReach end
local function attack(target)
    local method = S.AttackMode
    if method == "Auto" then method = ATTACK_METHODS[farm.methodIdx] or ATTACK_METHODS[1] end
    if method == "Remote (session)" or method == "Remote (old format)" then
        local list = {target}
        if curHitboxOn() and not Players:GetPlayerFromCharacter(target) then
            for _, m in ipairs(enemiesInRange(curHitReach(), target.Name)) do
                if m ~= target then list[#list+1]=m end
            end
        end
        remoteHit(list, method == "Remote (session)")
    end
    if S.AlsoSwing or method == "Tool swing only" or method == "Simulated click" then
        local ch = LP.Character; local tool = ch and ch:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end
    end
    if method == "Simulated click" then
        local vp = Camera.ViewportSize
        pcall(function()
            VIM:SendMouseButtonEvent(vp.X-50, vp.Y-50, 0, true, game, 0)
            VIM:SendMouseButtonEvent(vp.X-50, vp.Y-50, 0, false, game, 0)
        end)
    end
end

local hbOrig = setmetatable({}, {__mode="k"})
local function setHitbox(m, on)
    local r = m:FindFirstChild("HumanoidRootPart"); if not r then return end
    if on then
        if not hbOrig[r] then hbOrig[r] = {r.Size, r.Transparency, r.CanCollide} end
        if r.Size.X ~= S.HitboxSize then r.Size = Vector3.new(S.HitboxSize,S.HitboxSize,S.HitboxSize) end
        r.Transparency = 0.9; r.CanCollide = false
    else
        local o = hbOrig[r]
        if o then r.Size,r.Transparency,r.CanCollide = o[1],o[2],o[3]; hbOrig[r]=nil end
    end
end
restoreHitboxes = function()
    for r,o in pairs(hbOrig) do
        pcall(function() r.Size,r.Transparency,r.CanCollide = o[1],o[2],o[3] end)
        hbOrig[r] = nil
    end
end

local function boostOwnership()
    pcall(function() sethiddenproperty(LP,"SimulationRadius",math.huge) end)
