                    r.CFrame = CFrame.new(farm.pile); r.CanCollide=false
                    r.AssemblyLinearVelocity = Vector3.zero
                    local h = m:FindFirstChildOfClass("Humanoid"); if h then h.WalkSpeed=0 end
                end
