    ["Fishman Warrior"] = "whirlpool",
    ["Fishman Commando"] = "whirlpool",
    ["Reef Bandit"] = "submarine",
    ["Coral Pirate"] = "submarine",
    ["Sea Chanter"] = "submarine",
    ["Ocean Prophet"] = "submarine",
    ["High Disciple"] = "submarine",
    ["Grand Devotee"] = "submarine",
}

local function isUnderwaterQuest(mobName)
    return UNDERWATER_MOBS[mobName] ~= nil
end

local function getEntryType(mobName)
    return UNDERWATER_MOBS[mobName]
end

local function findNPCByName(name)
    local npcs = Workspace:FindFirstChild("NPCs")
    if not npcs then return nil end
    for _, m in ipairs(npcs:GetChildren()) do
        if m.Name:lower():find(name:lower(), 1, true) then
            local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
            if r then return m, r end
        end
    end
    return nil
end

local function goToWhirlpool()
    local root = getRoot()
    if not root then return false end
    local whirlPos = Vector3.new(-3350, 5, -1300)
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local locs = wo and wo:FindFirstChild("Locations")
    if locs then
        for _, c in ipairs(locs:GetChildren()) do
            if c.Name:lower():find("underwater") or c.Name:lower():find("whirl") then
                local pt = c:IsA("BasePart") and c or c:FindFirstChildWhichIsA("BasePart", true)
                if pt then whirlPos = pt.Position break end
            end
        end
    end
    setStatus("Yendo al Whirlpool (Underwater City)...")
    travelTo(whirlPos + Vector3.new(0, 15, 0), S.FarmSpeed)
    task.wait(1.2)
    local r = getRoot()
    if r then
        r.CFrame = CFrame.new(whirlPos + Vector3.new(0, 3, 0))
        task.wait(2.5)
    end
    return true
end

local function goToSubmarine()
    local root = getRoot()
    if not root then return false end
    local tikiPos = W.findLocation and W.findLocation("tiki")
    if not tikiPos then tikiPos = Vector3.new(-16526, 55, 473) end
    setStatus("Yendo a Tiki Outpost...")
    travelTo(tikiPos + Vector3.new(0, 40, 0), S.FarmSpeed)
    task.wait(1.3)
    local worker, workerPart = findNPCByName("Submarine Worker")
    if not workerPart then
        local subPort = W.findLocation and (W.findLocation("sub") or W.findLocation("port"))
        if subPort then
            travelTo(subPort + Vector3.new(0, 12, 0), S.FarmSpeed)
            task.wait(1)
            worker, workerPart = findNPCByName("Submarine Worker")
        end
    end
    if workerPart then
        setStatus("Hablando con Submarine Worker...")
        travelTo(workerPart.Position + Vector3.new(0, 3, 5), 150)
        task.wait(0.8)
        local cf = remote("CommF_")
        if cf then
            pcall(function() invoke(cf, "Submarine") end)
            pcall(function() invoke(cf, "TravelSubmerged") end)
            pcall(function() invoke(cf, "SubPort") end)
        end
        pcall(function()
            local prompt = worker:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                prompt:InputHoldBegin()
                task.wait(0.5)
                prompt:InputHoldEnd()
            end
        end)
        task.wait(3.2)
        return true
    end
    setStatus("No encontré Submarine Worker")
    return false
end

local function ensureUnderwaterEntry(mobName)
    local entryType = getEntryType(mobName)
    if not entryType then return true end
    local root = getRoot()
    if not root then return false end
    if root.Position.Y < -30 then return true end
    if entryType == "whirlpool" then return goToWhirlpool()
    elseif entryType == "submarine" then return goToSubmarine() end
    return true
end

local function farmStep()
    local root, hum = getRoot(), getHum()
    if not root or not hum or hum.Health <= 0 then farm.target=nil; setStatus("Waiting for respawn"); task.wait(1); return end
    autoEquip()
    if wantNPCs() and (os.clock()-farm.lastScan > 2 or #npcCache == 0) then scanNPCs(); farm.lastScan=os.clock() end
    local target = nearestTarget()
    if not target then
        if not farm.hold then farm.hold = root.Position end
        setStatus("Esperando enemigos...")
        if (root.Position - farm.hold).Magnitude > 30 then
            travelTo(farm.hold + Vector3.new(0, S.FarmHeight, 0), S.FarmSpeed)
        end
        task.wait(0.8)
        return
    end
    farm.hold = nil
    killTarget(target)
end

local function raidIslands()
    local out = {}
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local loc = wo and wo:FindFirstChild("Locations")
    if loc then
        for _,c in ipairs(loc:GetChildren()) do
            local num = c.Name:match("^Island (%d+)")
            if num then
                local pt = c:IsA("BasePart") and c or c:FindFirstChildWhichIsA("BasePart", true)
                if pt then out[#out+1] = {name=c.Name, num=tonumber(num), pos=pt.Position} end
            end
        end
    end
    return out
end
local function raidTimerOn()
    local gui = LP:FindFirstChild("PlayerGui"); local main = gui and gui:FindFirstChild("Main")
    local tm = main and main:FindFirstChild("Timer")
    return tm ~= nil and tm:IsA("GuiObject") and tm.Visible == true
end
local function raidNPCs(islands)
    local root = getRoot(); local out = {}
    for _,m in ipairs(enemyList()) do
        if m:IsA("Model") and isAlive(m) then
            local r = m:FindFirstChild("HumanoidRootPart")
            if r then
                local ok = false
                if #islands > 0 then
                    for _,isl in ipairs(islands) do if (r.Position-isl.pos).Magnitude <= S.RaidRadius then ok=true break end end
                elseif root then ok = (r.Position-root.Position).Magnitude <= 1500 end
                if ok then out[#out+1] = m end
            end
        end
    end
    return out
end
local function raidStep()
    local root, hum = getRoot(), getHum()
    if not root or not hum or hum.Health <= 0 then farm.target,farm.pile,farm.hold=nil,nil,nil; setStatus("Waiting for respawn"); task.wait(1); return end
    autoEquip()
    local islands = raidIslands()
    if #islands == 0 and not raidTimerOn() then farm.target,farm.pile,farm.hold=nil,nil,nil; setStatus("Waiting for a raid..."); task.wait(0.5); return end
    local target, bd
    for _,m in ipairs(raidNPCs(islands)) do
        local r = m:FindFirstChild("HumanoidRootPart")
        if r then local d=(r.Position-root.Position).Magnitude; if not bd or d<bd then target,bd=m,d end end
    end
    if target then farm.hold=nil; killTarget(target); return end
    farm.target, farm.pile = nil, nil
    if #islands > 0 then
        local newest = islands[1]
        for _,isl in ipairs(islands) do if isl.num > newest.num then newest=isl end end
        local spot = newest.pos + Vector3.new(0,S.RaidHeight,0)
        if (spot-root.Position).Magnitude > 40 then farm.hold=nil; setStatus("Flying to "..newest.name); travelTo(spot,S.FarmSpeed) end
        farm.hold = spot; setStatus("Waiting in the air for "..newest.name)
    else farm.hold = farm.hold or root.Position; setStatus("Waiting for raid NPC...") end
    task.wait(0.4)
end

local questCache, questFail, giverCache, bossAsked = {}, {}, {}, {}
local questsData
local function getQuests()
    if questsData == nil then
        local ok, q = pcall(function() return require(ReplicatedStorage:WaitForChild("Quests", 5)) end)
        questsData = (ok and type(q)=="table") and q or false
    end
    return questsData or nil
end
W.getQuests = getQuests
local function playerLevel()
    local d = LP:FindFirstChild("Data"); local l = d and d:FindFirstChild("Level")
    return l and l.Value or 1
end
local function mobExists(mobName)
    local wo = Workspace:FindFirstChild("_WorldOrigin"); local sp = wo and wo:FindFirstChild("EnemySpawns")
    if sp then for _,s in ipairs(sp:GetChildren()) do if string.find(s.Name, mobName, 1, true) then return true end end end
    local en = Workspace:FindFirstChild("Enemies")
    if en then for _,m in ipairs(en:GetChildren()) do if string.find(m.Name, mobName, 1, true) then return true end end end
    return false
end
local function pickQuest(level)
    local Quests = getQuests(); if not Quests then return nil end
    local function search(filter)
        local best
        for qName, list in pairs(Quests) do
            if type(list)=="table" then
                for idx, q in pairs(list) do
                    if type(q)=="table" and type(q.LevelReq)=="number" and q.LevelReq<=level and type(q.Task)=="table" then
                        local mob,cnt
                        for mn,c in pairs(q.Task) do mob,cnt=mn,c end
                        if mob and type(cnt)=="number" and cnt>1 and (not filter or mobExists(mob)) then
                            if not best or q.LevelReq>best.req then best={name=qName,index=idx,mob=mob,req=q.LevelReq} end
                        end
                    end
                end
            end
        end
        return best
    end
    return search(true) or search(false)
end
function W.bosses()
    local out, seen = {}, {}
    local Quests = getQuests()
    if Quests then
        for qName, list in pairs(Quests) do
            if type(list)=="table" then
                for idx, e in pairs(list) do
                    if type(e)=="table" and type(e.Task)=="table" and type(e.LevelReq)=="number" then
                        for mob,cnt in pairs(e.Task) do
                            if cnt==1 and not seen[mob] and mobExists(mob) then
                                seen[mob]=true; out[#out+1]={name=mob,req=e.LevelReq,quest=qName,index=idx}
                            end
                        end
                    end
                end
            end
        end
    end
    table.sort(out, function(a,b) return a.req<b.req end); return out
end
local function questActive()
    local gui = LP:FindFirstChild("PlayerGui"); local main = gui and gui:FindFirstChild("Main")
    local q = main and main:FindFirstChild("Quest")
    return q ~= nil and q.Visible == true
end
local function activeQuestMatches(mobName)
    local gui = LP:FindFirstChild("PlayerGui"); local main = gui and gui:FindFirstChild("Main")
    local q = main and main:FindFirstChild("Quest"); local c = q and q:FindFirstChild("Container")
    local qt = c and c:FindFirstChild("QuestTitle"); local t = qt and qt:FindFirstChild("Title")
    if not t or not t:IsA("TextLabel") then return true end
    return string.find(t.Text, mobName, 1, true) ~= nil
end
local function giverCandidates(mobName)
    local npcs = Workspace:FindFirstChild("NPCs"); local root = getRoot()
    if not npcs or not root then return {} end
    local ref = nearestSpawn(mobName) or root.Position; local list = {}
    for _,m in ipairs(npcs:GetChildren()) do
        local r = m:IsA("Model") and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart)
        if r then local d=(r.Position-ref).Magnitude; if d<700 then list[#list+1]={pos=r.Position,d=d} end end
    end
    table.sort(list, function(x,y) return x.d<y.d end); return list
end
local function startQuest(q)
    local cf = remote("CommF_"); if not cf then return false end
    local key = q.name..tostring(q.index)
    local function try() invoke(cf,"StartQuest",q.name,q.index); task.wait(0.7); return questActive() end
    if try() then return true end
    local spots = {}
    if giverCache[key] then spots[1]=giverCache[key] end
    for i,g in ipairs(giverCandidates(q.mob)) do if i>6 then break end; spots[#spots+1]=g.pos end
    for _,pos in ipairs(spots) do
        if not (alive and farmOn()) then return false end
        setStatus("Looking for quest giver"); travelTo(pos+Vector3.new(0,3,4), S.FarmSpeed); task.wait(0.4)
        if try() then giverCache[key]=pos; return true end
    end
    return false
end
local function respawnWait()
    local root,hum = getRoot(), getHum()
    if not root or not hum or hum.Health <= 0 then
        farm.target,farm.pile,farm.hold=nil,nil,nil; setStatus("Waiting for respawn"); task.wait(1); return true
    end
    return false
end
W.respawnWait = respawnWait; W.mobExists = mobExists
local islandCache = {}
local function islandOf(mobName)
    if islandCache[mobName] then return islandCache[mobName] end
    local result = "?"
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local spawns = wo and wo:FindFirstChild("EnemySpawns")
    local locs = wo and wo:FindFirstChild("Locations")
    if spawns and locs then
        local spos
        for _,s in ipairs(spawns:GetChildren()) do
            if string.find(s.Name, mobName, 1, true) then
                spos = s:IsA("BasePart") and s.Position or (s:IsA("Model") and s:GetPivot().Position)
                if spos then break end
            end
        end
        if spos then
            local best, bd
            for _,c in ipairs(locs:GetChildren()) do
                if not c.Name:match("^Island %d") then
                    local pt = c:IsA("BasePart") and c or c:FindFirstChildWhichIsA("BasePart", true)
                    if pt then local d=(pt.Position-spos).Magnitude; if not bd or d<bd then best,bd=c.Name,d end end
                end
            end
            if best then result = best end
        end
    end
    islandCache[mobName]=result; return result
end
function W.questEntries()
    local out = {}; local Quests = getQuests(); if not Quests then return out end
    for qName, list in pairs(Quests) do
        if type(list)=="table" then
            for idx, q in pairs(list) do
                if type(q)=="table" and type(q.LevelReq)=="number" and type(q.Task)=="table" then
                    local mob,cnt; for mn,c in pairs(q.Task) do mob,cnt=mn,c end
                    if mob and type(cnt)=="number" and cnt>1 and mobExists(mob) then
                        out[#out+1]={name=qName,index=idx,mob=mob,req=q.LevelReq,island=islandOf(mob)}
                    end
                end
            end
        end
    end
    table.sort(out, function(a,b) return a.req<b.req end); return out
end

STEP.level = function()
    if respawnWait() then return end
    autoEquip()
    local root = getRoot()
    local lvl = playerLevel()
    local q
    if S.QuestUsePick and S.QuestPick then q = S.QuestPick
    else
        q = questCache[lvl]
        if q == nil then q = pickQuest(lvl) or false; questCache[lvl] = q end
    end
    if not q then setStatus("No quest data - killing nearest"); return farmStep() end
    local key = q.name .. tostring(q.index)
    if questActive() and not activeQuestMatches(q.mob) then
        local cf = remote("CommF_")
        if cf then invoke(cf, "AbandonQuest") end
        task.wait(0.5)
    end
    if not questActive() and (questFail[key] or 0) < os.clock() then
        if isUnderwaterQuest(q.mob) then
            ensureUnderwaterEntry(q.mob)
        else
            local sp = nearestSpawn(q.mob)
            if sp and root and (root.Position - sp).Magnitude > 280 then
                setStatus("Flying to " .. q.mob .. " island")
                travelTo(sp + Vector3.new(0, S.FarmHeight + 6, 0), S.FarmSpeed)
            end
        end
        setStatus("Getting quest: " .. q.mob)
        if not startQuest(q) then
            questFail[key] = os.clock() + 45
            setStatus("Quest not accepted, farming anyway")
        end
    end
    if isUnderwaterQuest(q.mob) then ensureUnderwaterEntry(q.mob) end
    if os.clock() - farm.lastScan > 2 or #npcCache == 0 then scanNPCs(); farm.lastScan = os.clock() end
    local target, bd
    root = getRoot()
    for _, m in ipairs(enemyList()) do
        if m:IsA("Model") and isAlive(m) and string.find(m.Name, q.mob, 1, true) then
            local r = m:FindFirstChild("HumanoidRootPart")
            if r and root then
                local d = (r.Position - root.Position).Magnitude
                if not bd or d < bd then target, bd = m, d end
            end
        end
    end
    if target then farm.hold = nil; killTarget(target); return end
    if not farm.hold then farm.hold = root and root.Position or nil end
    if farm.hold then
        setStatus("Esperando enemigos de " .. q.mob .. "...")
        local r = getRoot()
        if r and (r.Position - farm.hold).Magnitude > 28 then
            travelTo(farm.hold + Vector3.new(0, S.FarmHeight, 0), S.FarmSpeed)
        end
    else
        local sp2 = nearestSpawn(q.mob)
        if sp2 then
            setStatus("Flying to " .. q.mob .. " spawn")
            travelTo(sp2 + Vector3.new(0, S.FarmHeight + 6, 0), S.FarmSpeed)
            farm.hold = sp2 + Vector3.new(0, S.FarmHeight + 6, 0)
        else setStatus("Can't find where " .. q.mob .. " spawns") end
    end
    task.wait(0.75)
end

STEP.boss = function()
    if respawnWait() then return end
    autoEquip()
    local root = getRoot(); local name = S.BossName
    if name == "" then setStatus("Pick a boss first"); task.wait(0.5); return end
    local boss
    for _,m in ipairs(enemyList()) do
        if m:IsA("Model") and isAlive(m) and m.Name == name then boss = m break end
    end
    if boss then
        if S.BossQuest and not questActive() and (bossAsked[name] or 0)+60 < os.clock() then
            bossAsked[name] = os.clock()
            for _, b in ipairs(W.bosses()) do
                if b.name == name then setStatus("Taking boss quest"); startQuest({name=b.quest,index=b.index,mob=name}); break end
            end
        end
        farm.hold = nil; killTarget(boss); return
    end
    farm.target, farm.pile = nil, nil
    local sp = nearestSpawn(name)
    if sp then
        local spot = sp+Vector3.new(0,S.FarmHeight+20,0)
        if (spot-root.Position).Magnitude > 40 then farm.hold=nil; setStatus("Flying to "..name.." spawn"); travelTo(spot,S.FarmSpeed) end
        farm.hold = spot; setStatus("Waiting in the air for "..name.." to spawn")
    else setStatus("Can't find where "..name.." spawns") end
    task.wait(0.5)
end

do
    local function partOf(o)
        if o:IsA("BasePart") then return o end
        if o:IsA("Model") then return o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart", true) end
        return o:FindFirstChild("Handle") or o:FindFirstChildWhichIsA("BasePart", true)
    end
    function W.scanFruits()
        local out = {}
        for _,o in ipairs(Workspace:GetChildren()) do
            if (o:IsA("Tool") or o:IsA("Model")) and string.find(o.Name,"Fruit",1,true) then
                local pt = o:FindFirstChild("Handle") or partOf(o)
                if pt then out[#out+1] = {inst=o,part=pt} end
            end
        end
        return out
    end
    function W.scanChests()
        local out = {}
        local cm = Workspace:FindFirstChild("ChestModels")
        if cm then for _,o in ipairs(cm:GetChildren()) do local pt=partOf(o); if pt then out[#out+1]={inst=o,part=pt} end end end
        for _,o in ipairs(Workspace:GetChildren()) do
            if o.Name:sub(1,5) == "Chest" and (o:IsA("BasePart") or o:IsA("Model")) then
                local pt = partOf(o); if pt then out[#out+1]={inst=o,part=pt} end
            end
        end
        return out
    end
    function W.nearest(list)
        local root = getRoot(); if not root then return nil end
        local best, bd
        for _,e in ipairs(list) do
            if e.part.Parent then
                local d = (e.part.Position-root.Position).Magnitude
                if not bd or d<bd then best,bd=e,d end
            end
        end
        return best
    end
    local function collect(kind)
        local root,hum = getRoot(), getHum()
        if not root or not hum or hum.Health <= 0 then farm.target,farm.hold=nil,nil; setStatus("Waiting for respawn"); task.wait(1); return end
        local e = W.nearest(kind=="fruit" and W.scanFruits() or W.scanChests())
        if not e then farm.target,farm.hold=nil,nil; setStatus(kind=="fruit" and "No fruit" or "No chests"); task.wait(1); return end
        setStatus("Collecting "..e.inst.Name)
        travelTo(e.part.Position+Vector3.new(0,3,0), S.FarmSpeed)
        local r = getRoot(); if r and e.part.Parent then r.CFrame = CFrame.new(e.part.Position) end
        task.wait(0.4)
    end
    STEP.fruit = function() collect("fruit") end
    STEP.chest = function() collect("chest") end
end

do
    local function findLoc(pattern)
        local wo = Workspace:FindFirstChild("_WorldOrigin"); local loc = wo and wo:FindFirstChild("Locations")
        if not loc then return nil end
        for _,c in ipairs(loc:GetChildren()) do
            if c.Name:lower():find(pattern,1,true) then
                local pt = c:IsA("BasePart") and c or c:FindFirstChildWhichIsA("BasePart", true)
                if pt then return pt.Position, c.Name end
            end
        end
        return nil
    end
    W.findLocation = findLoc
    local function waitAbove(pos, text)
        local root = getRoot(); if not root then return end
        local spot = pos+Vector3.new(0,S.FarmHeight+40,0)
        if (spot-root.Position).Magnitude > 40 then farm.hold=nil; setStatus("Flying to "..text); travelTo(spot,S.FarmSpeed) end
        farm.hold = spot; setStatus("Waiting in the air: "..text); task.wait(0.5)
    end
    local function nearestEnemy(match, center, radius)
        local root = getRoot(); if not root then return nil end
        local best, bd
        for _,m in ipairs(enemyList()) do
            if m:IsA("Model") and isAlive(m) and match(m) then
                local r = m:FindFirstChild("HumanoidRootPart")
                if r and (not center or (r.Position-center).Magnitude <= radius) then
                    local d = (r.Position-root.Position).Magnitude
                    if not bd or d<bd then best,bd=m,d end
                end
            end
        end
        return best
    end
    local function factoryBoss() return nearestEnemy(function(m) return m.Name==S.FactoryBoss end) end
    local function castleEnemy()
        local pos = findLoc("castle"); local key = S.CastleMob:lower()
        return nearestEnemy(function(m) return m.Name:lower():find(key,1,true)~=nil end, pos, 900)
    end
    local ev = {factory={active=false}, castle={active=false}}
    task.spawn(function()
        while alive do
            task.wait(2)
            local now = {factory=false, castle=false}
            pcall(function() now.factory = factoryBoss() ~= nil; now.castle = castleEnemy() ~= nil end)
            for k,e in pairs(ev) do
                if now[k] and not e.active then e.start = os.time() end
                if e.active and not now[k] then e.ended = os.time() end
                e.active = now[k]
            end
        end
    end)
    local function fmt(s) s=math.max(0,math.floor(s)); return string.format("%d:%02d", math.floor(s/60), s%60) end
    local function timerText(e, every)
        if e.active then return "ACTIVE right now" end
        if e.start then local since=os.time()-e.start; local left=every*60-since
            return "last seen "..fmt(since).." ago | est. next "..(left>0 and ("in "..fmt(left)) or "due now") end
        return "no data yet"
    end
    W.evTimers = function() return timerText(ev.factory,S.FactoryEvery), timerText(ev.castle,S.CastleEvery) end
    STEP.factory = function()
        if W.respawnWait() then return end
        autoEquip()
        local boss = factoryBoss()
        if boss then farm.hold=nil; killTarget(boss); return end
        local pos = findLoc("factory")
        if pos then waitAbove(pos, "the Factory raid") else setStatus("Factory not found"); task.wait(1) end
    end
    STEP.castle = function()
        if W.respawnWait() then return end
        autoEquip()
        local m = castleEnemy()
        if m then farm.hold=nil; killTarget(m); return end
        local pos = findLoc("castle")
        if pos then waitAbove(pos, "the castle raid") else setStatus("Castle not found"); task.wait(1) end
    end
    local function farmMob(name)
        local m = nearestEnemy(function(e) return string.find(e.Name,name,1,true)~=nil end)
        if m then farm.hold=nil; killTarget(m); return end
        local sp = nearestSpawn(name)
        if sp then waitAbove(sp, name) else setStatus("Can't find "..name); task.wait(1) end
    end
    local function hasFlower(i)
        for _,bag in ipairs({LP.Backpack, LP.Character}) do
            if bag then for _,t in ipairs(bag:GetChildren()) do
