local function travelTo(pos, speed)
    local root = getRoot(); if not root then return end
    local dist = (root.Position - pos).Magnitude
    if dist < 25 then root.CFrame = CFrame.new(pos); return end
    local limit = dist/speed
    local tw = TweenService:Create(root,TweenInfo.new(limit,Enum.EasingStyle.Linear),{CFrame=CFrame.new(pos)})
    local done = false; local c = tw.Completed:Connect(function() done=true end)
    farm.flying=true; tw:Play()
    local t0 = os.clock(); local tookOver = false
    while not done and alive and farmOn() and os.clock()-t0 < limit+4 do
        if S.MoveOverride and os.clock() < farm.pauseUntil then tookOver=true break end
        task.wait(0.1)
    end
    if not done then
        tw:Cancel()
        if not tookOver and alive and farmOn() then
            local r2 = getRoot(); if r2 then r2.CFrame = CFrame.new(pos) end
        end
    end
    c:Disconnect(); farm.flying = false
end

local function nearestSpawn(mobName)
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local folder = wo and wo:FindFirstChild("EnemySpawns")
    local root = getRoot()
    if not folder or not root then return nil end
    local best, bd
    for _, s in ipairs(folder:GetChildren()) do
        if not mobName or string.find(s.Name, mobName, 1, true) then
            local pos = s:IsA("BasePart") and s.Position or (s:IsA("Model") and s:GetPivot().Position)
            if pos then local d=(pos-root.Position).Magnitude; if not bd or d<bd then best,bd=pos,d end end
        end
    end
    return best
end

