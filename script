local function applyTheme(name)
local new = THEMES[name]
if not new then return end
local olds, news = {}, {}
for k, v in pairs(C) do
if new[k] and v ~= new[k] then
olds[#olds + 1] = v
news[#news + 1] = new[k]
end
end
local function swap(c)
for i = 1, #olds do
if c == olds[i] then return news[i] end
end
return c
end
