local function context(msg)
    local out = {}
    for n in tostring(msg):gmatch("hub:(%d+)") do
        local want, cur = tonumber(n), 0
        for line in (SRC .. "\n"):gmatch("(.-)\n") do
            cur += 1
            if cur == want then out[#out + 1] = want .. ": " .. line:sub(1, 120) break end
        end
        if #out >= 3 then break end
    end
    return table.concat(out, "\n")
end

local function showError(title, msg)
    msg = title .. "\n" .. tostring(msg) .. "\n\n" .. context(msg)
    warn("[Hub] " .. msg)
    pcall(function()
        local plr = game:GetService("Players").LocalPlayer
        local gui = Instance.new("ScreenGui")
        gui.Name, gui.ResetOnSpawn, gui.DisplayOrder = "HubError", false, 999
        local ok, ui = pcall(function() return gethui and gethui() end)
        local parent = ok and ui or nil
        if not (parent and pcall(function() gui.Parent = parent end)) then gui.Parent = plr:WaitForChild("PlayerGui") end
        local f = Instance.new("Frame")
        f.Size, f.Position = UDim2.fromOffset(470, 270), UDim2.new(0.5, -235, 0.5, -135)
        f.BackgroundColor3 = Color3.fromRGB(34, 22, 26)
        f.Parent = gui
        Instance.new("UICorner", f)
        local t = Instance.new("TextLabel")
        t.Size, t.BackgroundTransparency = UDim2.new(1, -90, 0, 30), 1
        t.Position, t.Text = UDim2.fromOffset(10, 0), "Script error - tap Copy and send it to me"
        t.TextColor3, t.Font, t.TextSize = Color3.fromRGB(255, 120, 120), Enum.Font.GothamBold, 14
        t.TextXAlignment = Enum.TextXAlignment.Left
        t.Parent = f
        local box = Instance.new("TextBox")
        box.Size, box.Position = UDim2.new(1, -20, 1, -50), UDim2.fromOffset(10, 38)
        box.BackgroundColor3, box.TextColor3 = Color3.fromRGB(20, 14, 16), Color3.fromRGB(240, 230, 230)
        box.Font, box.TextSize, box.Text = Enum.Font.Code, 12, msg
        box.MultiLine, box.TextWrapped, box.ClearTextOnFocus = true, true, false
        box.TextXAlignment, box.TextYAlignment = Enum.TextXAlignment.Left, Enum.TextYAlignment.Top
        box.Parent = f
        local function btn(text, x, cb)
            local b = Instance.new("TextButton")
            b.Size, b.Position, b.Text = UDim2.fromOffset(34, 24), UDim2.new(1, x, 0, 4), text
            b.BackgroundColor3, b.TextColor3 = Color3.fromRGB(70, 70, 90), Color3.new(1, 1, 1)
            b.Font, b.TextSize = Enum.Font.GothamBold, 13
            b.Parent = f
            Instance.new("UICorner", b)
            b.MouseButton1Click:Connect(function() cb(b) end)
            return b
        end
        local copy = btn("Cp", -80, function(b)
            if setclipboard then setclipboard(msg) b.Text = "OK" else b.Text = "no" end
        end)
        btn("X", -40, function() gui:Destroy() end)
    end)
end

local compile = loadstring or load
if not compile then
    showError("This executor has no loadstring", "")
else
    local fn, cerr = compile(SRC, "=hub")
    if not fn then
        showError("Compile error", cerr)
    else
        local ok, err = xpcall(fn, function(e) return debug.traceback(tostring(e), 2) end)
        if not ok then showError("Runtime error while loading", err) end
    end
end
